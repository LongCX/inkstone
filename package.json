{
  "name": "inkstone",
  "private": true,
  "version": "0.5.0",
  "license": "LGPL-3.0-only",
  "type": "module",
  "description": "Inkstone is a self-hosted Markdown notebook that runs entirely on Cloudflare Workers.",
  "homepage": "https://github.com/shuaiplus/inkstone#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuaiplus/inkstone.git"
  },
  "bugs": {
    "url": "https://github.com/shuaiplus/inkstone/issues"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:kv": "vite --mode kv",
    "dev:demo": "vite --mode demo",
    "build": "tsc -b && vite build",
    "build:kv": "tsc -b && vite build --mode kv",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && npx wrangler deploy --config dist/inkstone/wrangler.json",
    "deploy:kv": "npm run build:kv && npx wrangler deploy --config dist/inkstone/wrangler.json",
    "deploy:check": "npm run build && npx wrangler deploy --dry-run --config dist/inkstone/wrangler.json",
    "deploy:check:kv": "npm run build:kv && npx wrangler deploy --dry-run --config dist/inkstone/wrangler.json",
    "deploy:demo": "npm run build:demo && npx wrangler deploy --config wrangler.demo.toml",
    "typecheck": "tsc -b",
    "typecheck:force": "tsc -b --force",
    "test:unit": "vitest run --config vitest.config.ts",
    "i18n:check": "node scripts/check-i18n.mjs",
    "comments:check": "node scripts/check-comments.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "cf-typegen": "wrangler types",
    "cf-typegen:kv": "wrangler types --config wrangler.kv.toml"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@dicebear/core": "^9.4.3",
    "@dicebear/micah": "^9.4.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/server": "2.0.0",
    "@shikijs/core": "^4.3.1",
    "@shikijs/engine-oniguruma": "^4.3.1",
    "@shikijs/langs": "^4.3.1",
    "@shikijs/themes": "^4.3.1",
    "agents": "0.20.1",
    "aws4fetch": "^1.0.20",
    "client-zip": "2.5.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "hono": "4.12.34",
    "idb-keyval": "^6.3.0",
    "katex": "^0.18.1",
    "lucide-react": "^1.28.0",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-deflist": "^3.0.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-multimd-table": "^4.2.3",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.9.0",
    "zod": "4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/workers-types": "^5.20260730.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
